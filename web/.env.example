# Express backend used for JSON-file auth and contractor registry.
# In Vercel production, set this to your Render backend URL.
BACKEND_URL=http://localhost:5000

# Optional browser override. Leave blank when using the built-in Vercel API proxy.
NEXT_PUBLIC_AUTH_API_URL=

# Supabase is still used for shared report sync, not for auth accounts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
