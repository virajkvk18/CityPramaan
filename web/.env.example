NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: only set this if auth routes live on a different domain.
NEXT_PUBLIC_AUTH_API_URL=

# AI / RAG
# Required for Vercel-hosted Next.js AI routes.
CITYPRAMAAN_GROQ_API_KEY=your-groq-key
CITYPRAMAAN_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: set this only if the Python ai-service is deployed on Render/Railway/Fly.
AI_SERVICE_URL=
