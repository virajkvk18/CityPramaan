PORT=5000
NODE_ENV=development

# Required in production. Use a long random value.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=citypramaan-backend
JWT_AUDIENCE=citypramaan
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_CODE_LENGTH=6
RESEND_VERIFICATION_COOLDOWN_SECONDS=60

# Development only: when SMTP is not configured, expose the OTP in API responses.
# Never enable this in production.
EXPOSE_DEV_VERIFICATION_CODE=true

# Comma-separated frontend origins. Use * only for local throwaway testing.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Local durable storage. These are relative to citypramaan-backend when using npm scripts.
DATA_DIR=data
DATA_FILE=citypramaan-db.json
UPLOADS_DIR=uploads
MAX_UPLOAD_BYTES=8388608

# Optional: require invite codes for privileged self-registration.
ADMIN_INVITE_CODE=
CONTRACTOR_INVITE_CODE=

# Email verification. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CityPramaan <no-reply@citypramaan.local>
SMTP_TIMEOUT_MS=10000

# Optional: if absent, uploads are stored locally and served at /uploads.
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Optional AI services used by existing analyzer helpers.
ANTHROPIC_API_KEY=
